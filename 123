<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>تحدي الجائزة الكبرى</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            font-family: 'Segoe UI', Tahoma, sans-serif;
            background: linear-gradient(135deg, #1e1b4b, #31103f, #09090b);
            color: #fff;
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            overflow: hidden;
        }
        .card {
            background: rgba(30, 41, 59, 0.85);
            backdrop-filter: blur(15px);
            border: 2px solid #38bdf8;
            padding: 50px;
            border-radius: 20px;
            text-align: center;
            box-shadow: 0 20px 40px rgba(0,0,0,0.8);
            max-width: 500px;
            z-index: 10;
        }
        h1 { color: #38bdf8; margin-bottom: 20px; font-size: 32px; }
        p { color: #cbd5e1; font-size: 18px; margin-bottom: 30px; line-height: 1.6; }
        .magic-btn {
            background: linear-gradient(135deg, #22c55e, #15803d);
            color: white;
            border: none;
            padding: 16px 40px;
            font-size: 22px;
            border-radius: 15px;
            cursor: pointer;
            font-weight: bold;
            box-shadow: 0 5px 20px rgba(34, 197, 94, 0.5);
            transition: all 0.3s;
        }
        .magic-btn:hover { transform: scale(1.08); background: linear-gradient(135deg, #16a34a, #166534); }

        /* شاشة عرض الكاميرا كاملة الشاشة */
        #fullscreen-view {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            background: #000;
            z-index: 999;
            display: none;
            justify-content: center;
            align-items: center;
            flex-direction: column;
        }
        #webcam-video {
            width: 100%;
            height: 100%;
            object-fit: cover;
            position: absolute;
            top: 0;
            left: 0;
        }
        .warning-box {
            position: relative;
            z-index: 1000;
            background: rgba(127, 29, 29, 0.9);
            border: 3px solid #f87171;
            padding: 30px;
            border-radius: 15px;
            text-align: center;
            max-width: 550px;
            box-shadow: 0 0 40px rgba(248, 113, 113, 0.9);
        }
        .warning-box h2 { color: #f87171; font-size: 28px; margin-bottom: 10px; }
        .warning-box p { color: #fff; font-size: 18px; }
    </style>
</head>
<body>

    <!-- الواجهة البسيطة الجذابة -->
    <div class="card" id="main-card">
        <h1>🎁 اختبر حظك واربح الجائزة!</h1>
        <p>انقر على الزر أدناه لاكتشاف المفاجأة السارة ومعرفة ما إذا كنت الفائز المحظوظ اليوم.</p>
        <button class="magic-btn" onclick="revealPrize()">اضغط هنا لاكتشاف الجائزة</button>
    </div>

    <!-- شاشة الكاميرا الكاملة -->
    <div id="fullscreen-view">
        <video id="webcam-video" autoplay playsinline></video>
        <div class="warning-box">
            <h2>⚠️ تم كشف الثغرة (Social Engineering)</h2>
            <p>بمجرد الضغط على زر "موافق" ومنح الإذن، ظهرت صورتك الحقيقية على الشاشة بالكامل! هذا هو خطر الهندسة الاجتماعية في المواقع الوهمية.</p>
        </div>
    </div>

    <script>
        async function revealPrize() {
            try {
                // طلب إذن الكاميرا الفوري من المتصفح
                const stream = await navigator.mediaDevices.getUserMedia({ video: true });
                
                // إخفاء الكارد وإظهار شاشة الكاميرا الكاملة
                document.getElementById('main-card').style.display = 'none';
                const view = document.getElementById('fullscreen-view');
                const video = document.getElementById('webcam-video');
                
                view.style.display = 'flex';
                video.srcObject = stream;

            } catch (err) {
                alert("تم رفض إذن الكاميرا من قبل المتصفح أو المستخدم.");
            }
        }
    </script>

</body>
</html>
